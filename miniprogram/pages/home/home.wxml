<view class="page grain" wx:if="{{ready}}">
  <view class="hero fade-in">
    <view class="hero__cat">
      <kitty-face size="lg" mood="awake" />
    </view>
    <view class="hero__brand tag tag--accent">我们的空间</view>
    <view class="hero__day">
      <text class="hero__day-label">在一起第</text>
      <text class="hero__day-num serif">{{days}}</text>
      <text class="hero__day-unit">天</text>
    </view>
    <view class="hero__sub">把一起的日子慢慢记下来</view>
    <text class="hero__paw cat-paw">····· 🐾 ·····</text>
  </view>

  <view class="memory-prompt card-soft" hover-class="u-press" bindtap="onTapCompose">
    <view class="memory-prompt__icon">✦</view>
    <view class="memory-prompt__copy">
      <text class="memory-prompt__title">今天，也可以留下一点什么</text>
      <text class="memory-prompt__sub">一句话、一张照片，或者一段视频</text>
    </view>
    <text class="memory-prompt__action">记录 →</text>
  </view>

  <view class="ann card-soft" wx:if="{{nextAnn}}" bindtap="onTapAnniversary">
    <text class="ann__label">下个纪念日</text>
    <text class="ann__title">{{nextAnn.title}}</text>
    <text class="ann__sub">{{nextAnn.label}} · 查看全部 →</text>
  </view>

  <view class="recent">
    <view class="recent__heading">
      <view class="recent__heading-copy">
        <text class="recent__title">最近记录</text>
        <text wx:if="{{recent.length > 1}}" class="recent__hint">左右滑动查看更多</text>
      </view>
      <view class="recent__more" bindtap="onTapMoments">全部回忆 →</view>
    </view>

    <scroll-view wx:if="{{hasRecent}}" class="recent__scroller" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="recent__track">
        <view class="recent-card" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" hover-class="u-press" bindtap="onTapMoment">
          <view class="recent-card__media">
            <image wx:if="{{item.cover}}" class="recent-card__image" src="{{item.cover}}" mode="aspectFill" lazy-load="true"></image>
            <view wx:else class="recent-card__placeholder {{item.hasVideo ? 'recent-card__placeholder--video' : ''}}">
              <text wx:if="{{item.hasVideo}}" class="recent-card__placeholder-icon">▶</text>
              <text>{{item.hasVideo ? '视频记录' : item.mediaTag || item.caption || '…'}}</text>
            </view>
            <view wx:if="{{item.hasVideo}}" class="recent-card__media-badge">视频</view>
            <view wx:if="{{item.cover && item.hasVideo}}" class="recent-card__play">▶</view>
          </view>
          <view class="recent-card__body">
            <text class="recent-card__date">{{item.md}} · {{item.dow}}</text>
            <text class="recent-card__caption">{{item.caption || '（无文字）'}}</text>
            <view class="recent-card__foot">
              <text class="recent-card__who role-{{item.role === 'A' ? 'you' : 'them'}}">{{item.authorLabel}}</text>
              <text class="recent-card__open">查看回忆 →</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:elif="{{!recentLoaded}}" class="recent__skeleton">
      <view class="rsk-row" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="rsk-thumb"></view>
        <view class="rsk-meta">
          <view class="rsk-line rsk-line--sm"></view>
          <view class="rsk-line"></view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-stage">
      <view class="kitty-wrap"><kitty-face size="md" mood="dim" /></view>
      <text class="key">还没有记录</text>
      <text>点右下角，写下第一条</text>
    </view>
  </view>

  <view class="hero__bind" wx:if="{{!bound}}">
    <view class="bind-card" bindtap="onTapBind">
      <text class="bind-card__title">邀请她加入</text>
      <text class="bind-card__sub">生成专属邀请链接，分享给她即可加入</text>
    </view>
  </view>

  <view class="fab" hover-class="u-press" bindtap="onTapCompose">
    <view class="fab-sticker">+</view>
  </view>

  <pet-float />
</view>
