.page {
  min-height: 100vh;
  position: relative;
  background: var(--c-bg);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 40rpx var(--space-edge) 8rpx;
  text-align: center;
}
.hero__cat {
  display: flex;
  justify-content: center;
  margin-bottom: 12rpx;
}
.hero__brand {
  font-size: 24rpx;
}
.hero__day {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.hero__day-label {
  font-size: 28rpx;
  color: var(--c-muted);
}
.hero__day-num {
  font-size: var(--fs-hero);
  line-height: 1;
  color: var(--c-accent-deep);
  font-weight: 700;
}
.hero__day-unit {
  font-size: 30rpx;
  color: var(--c-text);
  font-weight: 600;
}
.hero__sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--c-muted);
}
.hero__paw {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
}

.memory-prompt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 30rpx var(--space-edge) 0;
  padding: 22rpx 24rpx;
  border-color: var(--c-accent-soft);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(237, 233, 246, 0.82));
}
.memory-prompt__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 18rpx 22rpx 16rpx 20rpx;
  background: var(--c-accent-soft);
  color: var(--c-accent-deep);
  font-size: 30rpx;
}
.memory-prompt__copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.memory-prompt__title {
  overflow: hidden;
  color: var(--c-text);
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.memory-prompt__sub {
  overflow: hidden;
  color: var(--c-muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.memory-prompt__action {
  flex-shrink: 0;
  color: var(--c-accent-deep);
  font-size: 22rpx;
  font-weight: 600;
}

.ann {
  margin: 20rpx var(--space-edge) 0;
  padding: 24rpx 28rpx;
}
.ann__label { font-size: 22rpx; color: var(--c-muted); }
.ann__title {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.ann__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-accent-deep);
}

.recent {
  margin-top: 48rpx;
  padding: 0 var(--space-edge);
}
.recent__heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 20rpx;
}
.recent__heading-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.recent__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
}
.recent__hint {
  font-size: 21rpx;
  color: var(--c-muted);
}
.recent__more {
  font-size: 24rpx;
  color: var(--c-accent-deep);
}
.recent__scroller {
  width: calc(100% + var(--space-edge));
  margin-right: calc(-1 * var(--space-edge));
  padding: 4rpx var(--space-edge) 14rpx 0;
  box-sizing: border-box;
  white-space: nowrap;
}
.recent__track {
  display: inline-flex;
  gap: 18rpx;
  vertical-align: top;
}
.recent-card {
  width: 520rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--c-surface);
  border: 1rpx solid var(--c-divider);
  border-radius: 22rpx;
  box-shadow: var(--c-shadow);
  vertical-align: top;
}
.recent-card__media {
  position: relative;
  width: 100%;
  height: 294rpx;
  overflow: hidden;
  background: var(--c-surface-soft);
}
.recent-card__image,
.recent-card__placeholder {
  width: 100%;
  height: 100%;
  display: block;
}
.recent-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 23rpx;
  color: var(--c-muted);
  padding: 20rpx;
  text-align: center;
}
.recent-card__placeholder--video {
  flex-direction: column;
  gap: 8rpx;
  background: linear-gradient(145deg, #302942, #1b1922);
  color: rgba(255, 255, 255, 0.82);
}
.recent-card__placeholder-icon {
  font-size: 42rpx;
  color: #fff;
}
.recent-card__media-badge {
  position: absolute;
  left: 14rpx;
  bottom: 14rpx;
  padding: 5rpx 9rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  font-size: 17rpx;
  letter-spacing: 1rpx;
  pointer-events: none;
}
.recent-card__play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 62rpx;
  height: 62rpx;
  margin-left: -31rpx;
  margin-top: -31rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(28, 24, 38, 0.7);
  color: #fff;
  font-size: 26rpx;
  pointer-events: none;
}
.recent-card__body {
  min-height: 142rpx;
  box-sizing: border-box;
  padding: 18rpx 22rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}
.recent-card__date {
  font-size: 21rpx;
  color: var(--c-muted);
}
.recent-card__caption {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.recent-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: auto;
}
.recent-card__who {
  font-size: 21rpx;
  font-weight: 500;
}
.recent-card__open {
  flex-shrink: 0;
  color: var(--c-accent-deep);
  font-size: 21rpx;
  font-weight: 600;
}

.hero__bind {
  margin: 40rpx var(--space-edge) 0;
}
.bind-card {
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 28rpx;
  text-align: center;
  border: 1rpx solid var(--c-accent-soft);
}
.bind-card__title {
  display: block;
  font-size: 28rpx;
  color: var(--c-text);
}
.bind-card__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-muted);
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

/* 最近记录加载骨架 */
.recent__skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.rsk-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.rsk-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.rsk-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.rsk-thumb,
.rsk-line {
  background: linear-gradient(90deg, rgba(139, 126, 200, 0.1) 25%, rgba(139, 126, 200, 0.2) 37%, rgba(139, 126, 200, 0.1) 63%);
  background-size: 400% 100%;
  animation: rsk-shimmer 1.4s ease infinite;
}
.rsk-line {
  height: 26rpx;
  border-radius: 999rpx;
}
.rsk-line--sm {
  width: 40%;
  height: 22rpx;
}
@keyframes rsk-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
