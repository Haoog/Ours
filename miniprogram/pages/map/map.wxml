<view class="page grain">
  <view class="head">
    <text class="head__title serif">足迹地图</text>
    <text class="head__sub">来自你们发动态时选的地点</text>
  </view>

  <view wx:if="{{!empty}}" class="map-wrap card-soft">
    <map
      class="map"
      latitude="{{centerLat}}"
      longitude="{{centerLng}}"
      scale="{{scale}}"
      markers="{{markers}}"
      show-location="{{false}}"
      bindmarkertap="onMarkerTap" />
  </view>

  <view wx:else class="empty-stage">
    <text class="key">还没有足迹</text>
    <text>发动态时选地点后会出现在这里</text>
  </view>

  <view class="cities card-soft" wx:if="{{cities.length > 0}}">
    <text class="cities__title">去过的地方</text>
    <view class="cities__row" wx:for="{{cities}}" wx:key="name">
      <text>{{item.name}}</text>
      <text class="cities__count">{{item.count}} 次</text>
    </view>
  </view>

  <pet-float />
</view>
