.page {
  min-height: 100vh;
  padding: 28rpx var(--space-edge) calc(48rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
}
.head { margin-bottom: 16rpx; }
.head__title { font-size: 40rpx; font-weight: 600; }
.head__sub { font-size: 24rpx; color: var(--c-muted); }
.map-wrap { overflow: hidden; border-radius: var(--r-card); }
.map { width: 100%; height: 480rpx; }
.cities { margin-top: 20rpx; padding: 24rpx 28rpx; }
.cities__title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.cities__row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--c-text);
  border-bottom: 1rpx solid var(--c-divider);
}
.cities__row:last-child { border-bottom: none; }
.cities__count { color: var(--c-accent-deep); }
