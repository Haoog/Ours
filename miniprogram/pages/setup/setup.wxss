.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  gap: 16rpx;
}

.hero__title {
  font-size: 40rpx;
  color: var(--text);
}

.hero__sub {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
  padding: 0 24rpx;
}

.setup-tip {
  margin: 0 32rpx 20rpx;
  padding: 22rpx 24rpx;
  font-size: 24rpx;
  color: var(--c-muted, rgba(74, 68, 88, 0.65));
  line-height: 1.65;
}

.form {
  margin: 24rpx 32rpx;
  padding: 24rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(139, 126, 200, 0.12);
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.field__input {
  font-size: 30rpx;
  color: var(--text);
}

.field__input--code {
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.field--picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field--avatar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field--avatar .field__label {
  margin-bottom: 0;
}

.avatar-pick {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: rgba(139, 126, 200, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-pick::after {
  border: none;
}

.avatar-pick__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.avatar-pick__ph {
  font-size: 44rpx;
  color: var(--accent);
  line-height: 1;
}

.field__val {
  font-size: 30rpx;
  color: var(--accent);
}

.btn-action {
  margin: 48rpx 32rpx;
}
