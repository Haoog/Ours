<view class="page grain">
  <view class="hero fade-in">
    <kitty-face size="lg" mood="awake" />
    <text class="hero__tag tag tag--accent">Ours</text>
    <text class="hero__title serif">创建我们的空间</text>
    <text class="hero__sub">她（{{partnerHint}}）打开小程序会自动加入，无需配对码</text>
  </view>

  <view class="form card-soft">
    <view class="field">
      <text class="field__label">你的昵称</text>
      <input class="field__input" placeholder="例如：我" maxlength="12" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>

    <picker mode="date" value="{{startDate}}" bindchange="onPickDate">
      <view class="field field--picker">
        <text class="field__label">在一起从</text>
        <text class="field__val">{{startDate}}</text>
      </view>
    </picker>
  </view>

  <view class="setup-tip card-soft">
    <text>首次使用没有数据是正常的：创建空间后，用右下角 + 记第一条动态即可。</text>
  </view>

  <view class="btn-action" bindtap="onSubmit">创建空间</view>
</view>
