.reel-page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
}

.reel-hero {
  padding: 24rpx var(--space-edge) 16rpx;
}
.reel-hero__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.reel-hero__tag { font-size: 22rpx; }
.reel-hero__title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--c-accent-deep);
  letter-spacing: 4rpx;
}
.reel-hero__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--c-muted);
  line-height: 1.5;
}

.view-tabs {
  margin: 0 var(--space-edge) 12rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 var(--space-edge) 12rpx;
  gap: 12rpx;
}
.search-bar__input {
  flex: 1;
  padding: 16rpx 24rpx;
  background: var(--c-surface);
  border-radius: var(--r-pill);
  font-size: 28rpx;
}
.search-bar__clear { font-size: 26rpx; color: var(--c-accent); }

.filters {
  white-space: nowrap;
  padding: 0 var(--space-edge) 16rpx;
}
.filters .seg-sticker--chip {
  margin-right: 12rpx;
  background: var(--c-surface);
}
.filters .seg-sticker--chip.is-on {
  background: var(--c-accent-soft);
}

.otd-strip {
  white-space: nowrap;
  padding: 0 var(--space-edge) 20rpx;
}
.otd-strip__label {
  display: inline-block;
  vertical-align: top;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--c-accent-deep);
  font-weight: 600;
  margin-right: 16rpx;
  padding-top: 56rpx;
}
.otd-ticket {
  display: inline-block;
  vertical-align: top;
  width: 200rpx;
  margin-right: 14rpx;
  padding: 12rpx;
  background: var(--c-surface);
  border-radius: 20rpx;
  box-shadow: var(--c-shadow);
  border: 1rpx solid var(--c-divider);
  transform: none;
}
.otd-ticket:nth-child(even) { transform: none; }
.otd-ticket__no {
  display: block;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--c-accent);
  margin-bottom: 8rpx;
}
.otd-ticket__media {
  position: relative;
  width: 100%;
  height: 120rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #302942, #1b1922);
}
.otd-ticket__img,
.otd-ticket__placeholder {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  display: block;
}
.otd-ticket__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
}
.otd-ticket__placeholder-icon {
  color: #fff;
  font-size: 26rpx;
}
.otd-ticket__play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  margin-left: -20rpx;
  margin-top: -20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(28, 24, 38, 0.7);
  color: #fff;
  font-size: 18rpx;
  pointer-events: none;
}
.otd-ticket__badge {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 3rpx 6rpx;
  border-radius: 5rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  pointer-events: none;
}
.otd-ticket__date {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-muted);
}
.otd-ticket__cap {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reel-stream {
  padding: 8rpx 0 0;
}

.reel-month {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx var(--space-edge) 16rpx;
}
.reel-month__line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--c-accent-soft), transparent);
}
.reel-month__text {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--c-accent-deep);
  font-weight: 600;
}

.reel-milestone {
  margin: 8rpx var(--space-edge) 20rpx;
  padding: 24rpx;
  text-align: center;
  border-radius: var(--r-card);
  background: linear-gradient(135deg, rgba(212, 165, 116, 0.22), rgba(var(--c-accent-rgb), 0.14));
  border: 1rpx dashed rgba(var(--c-accent-rgb), 0.35);
}
.reel-milestone__star {
  display: block;
  font-size: 28rpx;
  color: var(--c-accent);
}
.reel-milestone__title {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.reel-milestone__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-muted);
}

/* —— 照片日记卡片 —— */
.scene {
  display: flex;
  align-items: stretch;
  padding: 0 var(--space-edge) 28rpx;
  margin-bottom: 4rpx;
}
.scene--a .scene__cell,
.scene--b .scene__cell { transform: none; }

.scene__sprocket {
  display: none;
}

.scene__cell {
  flex: 1;
  min-width: 0;
  position: relative;
  padding: 20rpx 20rpx 18rpx;
  background: var(--c-surface);
  border-radius: 20rpx;
  box-shadow:
    0 16rpx 40rpx rgba(var(--c-deep-rgb), 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(var(--c-accent-rgb), 0.12);
  overflow: hidden;
  transition: transform 0.25s ease;
}
.scene--you .scene__cell {
  border-left: 4rpx solid var(--c-you);
}
.scene--them .scene__cell {
  border-left: 4rpx solid var(--c-them);
}

.scene__watermark {
  position: absolute;
  right: 12rpx;
  top: 8rpx;
  font-size: 76rpx;
  font-weight: 700;
  color: rgba(var(--c-accent-rgb), 0.07);
  line-height: 1;
  pointer-events: none;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.scene__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}
.scene__index {
  display: block;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--c-accent);
  font-weight: 600;
}
.scene__author {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.scene__head-right { text-align: right; }
.scene__md {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.scene__dow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--c-muted);
  margin-top: 2rpx;
}

/* 媒体区域：图片只负责展示，正文统一放在下方 */
.scene__cinema {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  min-height: 280rpx;
  background: linear-gradient(145deg, #2a2438, #1a1820);
}
.scene__cinema-img {
  width: 100%;
  height: 360rpx;
  display: block;
}
.scene__cinema-badges {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  z-index: 2;
}
.scene__badge {
  padding: 6rpx 14rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 6rpx;
  backdrop-filter: blur(8px);
}
.scene__cinema--empty {
  min-height: 280rpx;
}
.scene__cinema-empty {
  width: 100%;
  height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}
.scene__cinema-empty-icon {
  color: #fff;
  font-size: 42rpx;
}
.scene__cinema-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(28, 24, 38, 0.68);
  color: #fff;
  font-size: 30rpx;
  pointer-events: none;
}

/* Bento 不对称拼贴 */
.scene__bento {
  position: relative;
  display: grid;
  gap: 8rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.scene__bento--2 {
  grid-template-columns: 1.2fr 0.8fr;
  grid-template-rows: 240rpx;
}
.scene__bento--3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 200rpx 160rpx;
}
.scene__bento--3 .scene__bento-cell--0 {
  grid-column: 1 / 3;
}
.scene__bento--4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 180rpx 180rpx;
}
.scene__bento-cell {
  position: relative;
  overflow: hidden;
  background: var(--c-surface-soft);
}
.scene__bento-img {
  width: 100%;
  height: 100%;
  min-height: 120rpx;
  display: block;
}
.scene__bento-video-mark,
.scene__frame-video-mark {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 5rpx 9rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.52);
  color: #fff;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  pointer-events: none;
}
/* 横向照片条（多图） */
.scene__filmstrip {
  margin: 0 -4rpx;
}
.scene__filmstrip-inner {
  display: inline-flex;
  gap: 10rpx;
  padding: 4rpx 4rpx 12rpx;
  white-space: nowrap;
}
.scene__frame-thumb {
  position: relative;
  width: 200rpx;
  height: 260rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(var(--c-text-rgb), 0.2);
  transform: none;
}
.scene__frame-thumb:nth-child(even) { transform: none; }
.scene__frame-thumb image {
  width: 100%;
  height: 100%;
  display: block;
}
.scene__frame-more {
  width: 120rpx;
  height: 260rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--c-accent-soft);
  color: var(--c-accent-deep);
  font-size: 32rpx;
  font-weight: 600;
}

/* 图文动态统一的正文区域：与图片分离，保证长文可读 */
.scene__caption {
  margin-top: 18rpx;
  padding: 16rpx 20rpx 18rpx;
  background: linear-gradient(135deg, rgba(var(--c-accent-rgb), 0.08), rgba(255, 255, 255, 0.86));
  border: 1rpx solid var(--c-divider);
  border-left: 4rpx solid var(--c-accent);
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  position: relative;
  z-index: 1;
}
.scene__caption-text {
  display: block;
  font-size: 29rpx;
  line-height: 1.65;
  color: var(--c-text);
  white-space: pre-wrap;
}

/* 纯文字诗卡 */
.scene__verse {
  padding: 32rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, var(--c-surface-soft), rgba(255, 255, 255, 0.9));
  border: 1rpx solid var(--c-divider);
}
.scene__verse-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--c-text);
  font-weight: 500;
}
.scene__verse-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--c-accent);
}

.scene__signal {
  padding: 28rpx 8rpx;
  position: relative;
  z-index: 1;
}
.scene__signal-badge {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--c-accent-deep);
  font-weight: 600;
}
.scene__signal-text {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.scene__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--c-muted);
  position: relative;
  z-index: 1;
}
.scene__tag {
  color: var(--c-accent);
  font-weight: 500;
}
.scene__loc::before { content: '📍 '; }

.scene__pulse {
  display: flex;
  gap: 24rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--c-divider);
  position: relative;
  z-index: 1;
}
.scene__pulse-item {
  font-size: 24rpx;
  color: var(--c-muted);
  letter-spacing: 1rpx;
}
.scene__pulse-item.is-on { color: #c45c6a; }

.map-panel { padding: 0 var(--space-edge) 48rpx; }
.map-panel__intro { padding: 8rpx 4rpx 18rpx; }
.map-panel__kicker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--c-accent-deep);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  font-weight: 600;
}
.map-panel__title {
  display: block;
  margin-top: 8rpx;
  color: var(--c-text);
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.map-panel__sub {
  display: block;
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.55;
}
.map-panel__stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 18rpx 10rpx;
  margin-bottom: 18rpx;
}
.map-panel__stat {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.map-panel__stat text:first-child {
  color: var(--c-accent-deep);
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 700;
}
.map-panel__stat text:last-child {
  margin-top: 4rpx;
  color: var(--c-muted);
  font-size: 21rpx;
}
.map-panel__stat-divider {
  width: 1rpx;
  height: 46rpx;
  background: var(--c-divider);
}
.map-panel__map-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 26rpx;
  background: #E8E5EF;
}
.map-panel__map {
  display: block;
  width: 100%;
  height: 500rpx;
}
.map-panel__stamp,
.map-panel__hint {
  position: absolute;
  z-index: 2;
  border-radius: var(--r-pill);
  pointer-events: none;
}
.map-panel__stamp {
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 7rpx 13rpx;
  background: rgba(255, 255, 255, 0.88);
  color: var(--c-accent-deep);
  font-size: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(var(--c-text-rgb), 0.1);
}
.map-panel__stamp text:first-child { color: #C97991; font-size: 22rpx; }
.map-panel__hint {
  right: 18rpx;
  bottom: 16rpx;
  padding: 5rpx 11rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--c-muted);
  font-size: 19rpx;
}
.map-place-section { margin-top: 28rpx; }
.map-place-section__head,
.map-cities__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.map-place-section__title,
.map-cities__title {
  display: block;
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 700;
}
.map-place-section__sub {
  display: block;
  margin-top: 2rpx;
  color: var(--c-muted);
  font-size: 20rpx;
}
.map-place-section__count,
.map-cities__head > text:last-child {
  color: var(--c-accent-deep);
  font-size: 21rpx;
}
.map-place-chips {
  width: calc(100% + 72rpx);
  margin: 0 -36rpx 6rpx;
  padding: 4rpx 36rpx 14rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.map-place-chip {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  height: 62rpx;
  margin-right: 12rpx;
  padding: 0 15rpx;
  border: 1rpx solid var(--c-divider);
  border-radius: 22rpx 28rpx 20rpx 26rpx;
  background: rgba(255, 255, 255, 0.74);
  color: var(--c-muted);
  vertical-align: top;
}
.map-place-chip.is-on {
  border-color: transparent;
  background: var(--c-accent-soft);
  color: var(--c-accent-deep);
  box-shadow: 0 6rpx 16rpx rgba(var(--c-deep-rgb), 0.1);
}
.map-place-chip__mark { color: #C97991; font-size: 21rpx; }
.map-place-chip.is-on .map-place-chip__mark { color: var(--c-accent-deep); }
.map-place-chip__name {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 23rpx;
}
.map-place-chip__count {
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  border-radius: var(--r-pill);
  background: rgba(var(--c-deep-rgb), 0.1);
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
}
.map-story { overflow: hidden; border-radius: 24rpx; }
.map-story__media { position: relative; width: 100%; height: 250rpx; background: var(--c-surface-soft); }
.map-story__image,
.map-story__placeholder { display: block; width: 100%; height: 100%; }
.map-story__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  background: linear-gradient(145deg, #302942, #1B1922);
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}
.map-story__placeholder text:first-child { color: #FFFFFF; font-size: 44rpx; line-height: 1; }
.map-story__tag {
  position: absolute;
  left: 16rpx;
  bottom: 14rpx;
  padding: 5rpx 9rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #FFFFFF;
  font-size: 16rpx;
  letter-spacing: 1rpx;
}
.map-story__body { padding: 20rpx 22rpx 22rpx; }
.map-story__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}
.map-story__title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--c-text);
  font-size: 30rpx;
  font-weight: 700;
}
.map-story__total { flex-shrink: 0; color: var(--c-accent-deep); font-size: 20rpx; }
.map-story__address {
  display: block;
  margin-top: 2rpx;
  overflow: hidden;
  color: var(--c-muted);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.map-story__content {
  display: block;
  margin-top: 13rpx;
  color: var(--c-text);
  font-size: 25rpx;
  line-height: 1.55;
}
.map-story__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 16rpx;
  color: var(--c-muted);
  font-size: 20rpx;
}
.map-story__open { flex-shrink: 0; color: var(--c-accent-deep); font-weight: 600; }
.map-cities {
  margin-top: 24rpx;
  padding: 20rpx 22rpx 22rpx;
  background: var(--c-surface);
  border: 1rpx solid var(--c-divider);
  border-radius: var(--r-card);
  box-shadow: var(--c-shadow);
}
.map-cities__head > text:last-child { color: var(--c-muted); font-size: 20rpx; }
.map-cities__list {
  width: calc(100% + 44rpx);
  margin: 0 -22rpx;
  padding: 2rpx 22rpx 4rpx;
  box-sizing: border-box;
  white-space: nowrap;
}
.map-cities__chip {
  display: inline-flex;
  align-items: baseline;
  gap: 7rpx;
  margin-right: 9rpx;
  padding: 9rpx 14rpx;
  border-radius: 16rpx 20rpx 14rpx 18rpx;
  background: var(--c-surface-soft);
  vertical-align: top;
  color: var(--c-text);
  font-size: 23rpx;
}
.map-cities__chip text:last-child { color: var(--c-accent-deep); font-size: 19rpx; }
.map-empty {
  margin-top: 24rpx;
  padding: 42rpx 28rpx 38rpx;
  text-align: center;
}
.map-empty__seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 16rpx;
  border: 1rpx solid var(--c-accent-soft);
  border-radius: 50%;
  background: var(--c-surface-soft);
  color: var(--c-accent);
  font-size: 30rpx;
}
.map-empty__title { display: block; color: var(--c-text); font-size: 29rpx; font-weight: 700; }
.map-empty__sub { display: block; margin-top: 10rpx; color: var(--c-muted); font-size: 23rpx; line-height: 1.7; }

.collections-panel,
.recap-panel {
  padding: 8rpx var(--space-edge) calc(160rpx + env(safe-area-inset-bottom));
}

.collections-hero,
.recap-cover {
  position: relative;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  min-height: 206rpx;
  box-sizing: border-box;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid var(--c-divider);
  background: linear-gradient(135deg, #FFFFFF 0%, #F5F1FB 60%, #EDE8F6 100%);
}
.collections-hero::after,
.recap-cover::after {
  content: '';
  position: absolute;
  right: -62rpx;
  bottom: -86rpx;
  width: 226rpx;
  height: 226rpx;
  border-radius: 50%;
  background: rgba(var(--c-accent-rgb), 0.13);
}
.collections-hero__copy,
.recap-cover__copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  max-width: 72%;
}
.collections-hero__eyebrow,
.recap-cover__eyebrow {
  display: block;
  color: var(--c-accent-deep);
  font-size: 21rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}
.collections-hero__title,
.recap-cover__title {
  display: block;
  margin-top: 14rpx;
  color: var(--c-text);
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
}
.collections-hero__sub,
.recap-cover__sub {
  display: block;
  margin-top: 12rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  line-height: 1.55;
}
.collections-hero__stamp,
.recap-cover__stamp {
  position: relative;
  z-index: 1;
  align-self: flex-end;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(var(--c-deep-rgb), 0.22);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.64);
  transform: rotate(4deg);
}
.collections-hero__stamp-number,
.recap-cover__number {
  color: var(--c-accent-deep);
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
}
.collections-hero__stamp-label,
.recap-cover__label {
  margin-top: 6rpx;
  color: var(--c-muted);
  font-size: 20rpx;
}
.recap-cover__title { font-size: 36rpx; }
.recap-cover__sub { margin-top: 16rpx; }

.collection-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 34rpx 4rpx 16rpx;
}
.collection-section-head--places { padding-top: 42rpx; }
.recap-section-head { padding-top: 38rpx; }
.collection-section-head__copy { min-width: 0; }
.collection-section-head__title {
  display: block;
  color: var(--c-text);
  font-size: 31rpx;
  font-weight: 700;
}
.collection-section-head__sub {
  display: block;
  margin-top: 4rpx;
  color: var(--c-muted);
  font-size: 22rpx;
}
.collection-section-head__count {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: var(--c-accent-deep);
  font-size: 22rpx;
}

.coll-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.coll-card {
  position: relative;
  width: calc(50% - 8rpx);
  min-height: 190rpx;
  box-sizing: border-box;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid var(--c-divider);
  border-radius: 22rpx;
  box-shadow: var(--c-shadow);
}
.coll-card--daily { background: linear-gradient(145deg, #FFFFFF, #F8F4EA); }
.coll-card--travel { background: linear-gradient(145deg, #FFFFFF, #EEF6F6); }
.coll-card--rant { background: linear-gradient(145deg, #FFFFFF, #F5F0FA); }
.coll-card--default { background: linear-gradient(145deg, #FFFFFF, #F3F1F8); }
.coll-card__top { display: flex; align-items: flex-start; gap: 12rpx; }
.coll-card__icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--c-accent-deep);
  font-size: 29rpx;
  font-weight: 600;
}
.coll-card--travel .coll-card__icon { color: #557F84; }
.coll-card--rant .coll-card__icon { color: #9A6E91; }
.coll-card__copy { min-width: 0; flex: 1; }
.coll-card__label {
  display: block;
  overflow: hidden;
  color: var(--c-text);
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.coll-card__count {
  display: block;
  margin-top: 5rpx;
  color: var(--c-muted);
  font-size: 21rpx;
}
.coll-card__arrow {
  flex-shrink: 0;
  color: var(--c-muted);
  font-size: 27rpx;
  line-height: 1;
}
.coll-card__bar,
.place-row__bar {
  height: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: var(--r-pill);
  background: rgba(var(--c-accent-rgb), 0.12);
}
.coll-card__bar-fill,
.place-row__bar-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--c-accent);
}
.coll-card--travel .coll-card__bar-fill { background: #7BA7A5; }
.coll-card--rant .coll-card__bar-fill { background: #B18BB0; }
.coll-card__hint {
  display: block;
  margin-top: 14rpx;
  color: var(--c-accent-deep);
  font-size: 21rpx;
}

.place-list { display: flex; flex-direction: column; gap: 12rpx; }
.place-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--c-divider);
  border-radius: 20rpx;
  background: var(--c-surface);
  box-shadow: 0 8rpx 24rpx rgba(var(--c-deep-rgb), 0.08);
}
.place-row__rank {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--c-surface-soft);
  color: var(--c-accent-deep);
  font-size: 21rpx;
  font-weight: 600;
}
.place-row__copy { min-width: 0; flex: 1; }
.place-row__top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.place-row__name {
  min-width: 0;
  overflow: hidden;
  color: var(--c-text);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.place-row__n { flex-shrink: 0; color: var(--c-muted); font-size: 21rpx; }
.place-row__bar { height: 6rpx; margin-top: 11rpx; }
.place-row__bar-fill { background: #87A8A9; }
.place-row__arrow { flex-shrink: 0; color: var(--c-muted); font-size: 28rpx; }
.collection-empty {
  padding: 38rpx 28rpx;
  text-align: center;
  border: 1rpx dashed rgba(var(--c-accent-rgb), 0.28);
  background: rgba(255, 255, 255, 0.7);
}
.collection-empty--small { margin-top: 0; }
.collection-empty__icon { display: block; color: var(--c-accent); font-size: 30rpx; }
.collection-empty__title { display: block; margin-top: 8rpx; color: var(--c-text); font-size: 28rpx; font-weight: 600; }
.collection-empty__sub { display: block; margin-top: 6rpx; color: var(--c-muted); font-size: 22rpx; line-height: 1.6; }

.recap-months {
  width: calc(100% + var(--space-edge));
  margin-right: calc(-1 * var(--space-edge));
  padding: 4rpx var(--space-edge) 12rpx 0;
  box-sizing: border-box;
  white-space: nowrap;
}
.recap-month {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 82rpx;
  margin-right: 10rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--c-divider);
  border-radius: 20rpx;
  background: var(--c-surface);
  color: var(--c-muted);
  vertical-align: top;
}
.recap-month__number { font-size: 31rpx; line-height: 1.1; font-weight: 700; }
.recap-month__label { margin-top: 4rpx; font-size: 19rpx; }
.recap-month.is-on {
  border-color: var(--c-accent);
  background: var(--c-accent);
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(var(--c-deep-rgb), 0.22);
}
.recap-stats { margin-top: 14rpx; padding: 28rpx; border: 1rpx solid var(--c-divider); }
.recap-stats__head { display: flex; align-items: flex-start; justify-content: space-between; }
.recap-stats__title { display: block; color: var(--c-text); font-size: 32rpx; font-weight: 700; }
.recap-stats__sub { display: block; margin-top: 5rpx; color: var(--c-muted); font-size: 21rpx; }
.recap-stats__mark { color: var(--c-accent); font-size: 32rpx; }
.recap-metrics { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.recap-metric { width: 50%; box-sizing: border-box; padding: 16rpx 0 14rpx; border-top: 1rpx solid var(--c-divider); }
.recap-metric:nth-child(odd) { padding-right: 18rpx; border-right: 1rpx solid var(--c-divider); }
.recap-metric:nth-child(even) { padding-left: 18rpx; }
.recap-metric__value { display: block; color: var(--c-text); font-size: 37rpx; line-height: 1.15; font-weight: 700; }
.recap-metric--primary .recap-metric__value { color: var(--c-accent-deep); font-size: 48rpx; }
.recap-metric__label { display: block; margin-top: 4rpx; color: var(--c-muted); font-size: 21rpx; }
.recap-share { margin-top: 18rpx; }
.recap-share__bar { display: flex; height: 14rpx; overflow: hidden; border-radius: var(--r-pill); background: var(--c-surface-soft); }
.recap-share__bar-a { height: 100%; background: var(--c-you); }
.recap-share__bar-b { height: 100%; background: var(--c-them); }
.recap-share__legend { display: flex; justify-content: space-between; margin-top: 9rpx; color: var(--c-muted); font-size: 21rpx; }
.recap-share__dot { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 6rpx; border-radius: 50%; vertical-align: -1rpx; }
.recap-share__dot--a { background: var(--c-you); }
.recap-share__dot--b { background: var(--c-them); }
.recap-tone {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--c-divider);
}
.recap-tone__label { color: var(--c-muted); font-size: 21rpx; }
.recap-tone__value { color: var(--c-accent-deep); font-size: 25rpx; font-weight: 600; }
.recap-empty { margin-top: 14rpx; padding: 58rpx 28rpx; text-align: center; border: 1rpx dashed rgba(var(--c-accent-rgb), 0.28); }
.recap-empty__icon { display: block; color: var(--c-accent); font-size: 36rpx; }
.recap-empty__title { display: block; margin-top: 10rpx; color: var(--c-text); font-size: 29rpx; font-weight: 600; }
.recap-empty__sub { display: block; margin-top: 8rpx; color: var(--c-muted); font-size: 23rpx; }
.recap-empty__action { display: inline-block; margin-top: 24rpx; padding: 12rpx 24rpx; border-radius: var(--r-pill); background: var(--c-accent-soft); color: var(--c-accent-deep); font-size: 24rpx; }

.load-more {
  text-align: center;
  padding: 40rpx 0 48rpx;
  color: var(--c-muted);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.load-more--hint { color: var(--c-accent); }

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

/* 加载骨架屏：替代加载期误显的「空状态」 */
.reel-skeleton {
  padding: 8rpx 28rpx 40rpx;
}
.sk-card {
  background: var(--c-surface);
  border: 1rpx solid var(--c-divider);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.sk-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.sk-line,
.sk-thumb {
  background: linear-gradient(90deg, rgba(var(--c-accent-rgb), 0.1) 25%, rgba(var(--c-accent-rgb), 0.2) 37%, rgba(var(--c-accent-rgb), 0.1) 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.4s ease infinite;
}
.sk-line {
  height: 26rpx;
  border-radius: 999rpx;
}
.sk-line + .sk-line {
  margin-top: 16rpx;
}
.sk-line--head {
  width: 180rpx;
}
.sk-line--date {
  width: 110rpx;
}
.sk-line--short {
  width: 60%;
}
.sk-thumb {
  height: 300rpx;
  border-radius: 20rpx;
  margin: 18rpx 0 24rpx;
}
@keyframes sk-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* 加载失败重试 */
.err-banner {
  margin: 16rpx 28rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--c-accent-deep);
  line-height: 1.5;
  text-align: center;
}
.err-banner__retry {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-muted);
}
.text-collapsed {
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.text-expand { display: block; margin-top: 8rpx; color: var(--c-accent-deep); font-size: 24rpx; }
.context-filter { margin: 0 var(--space-edge) 16rpx; display: flex; justify-content: space-between; gap: 16rpx; color: var(--c-accent-deep); font-size: 24rpx; }
.place-all { margin: 18rpx 0; padding: 16rpx 0; text-align: center; color: var(--c-accent-deep); font-size: 26rpx; }
.recap-year { padding: 12rpx 0 18rpx; color: var(--c-accent-deep); font-size: 28rpx; }
.recap-photo-grid { margin-top: 24rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.recap-photo-grid image, .recap-photo-placeholder { width: 100%; height: 170rpx; border-radius: 12rpx; }
.recap-photo-grid text { display: block; color: var(--c-muted); font-size: 22rpx; }
.recap-photo-placeholder { box-sizing: border-box; padding: 18rpx; overflow: hidden; background: var(--c-surface-soft); color: var(--c-text); font-size: 22rpx; }
