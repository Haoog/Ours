.reel-page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
}

.reel-hero {
  padding: 24rpx var(--space-edge) 16rpx;
}
.reel-hero__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.reel-hero__tag { font-size: 22rpx; }
.reel-hero__title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--c-accent-deep);
  letter-spacing: 4rpx;
}
.reel-hero__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--c-muted);
  line-height: 1.5;
}

.view-tabs {
  margin: 0 var(--space-edge) 12rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 var(--space-edge) 12rpx;
  gap: 12rpx;
}
.search-bar__input {
  flex: 1;
  padding: 16rpx 24rpx;
  background: var(--c-surface);
  border-radius: var(--r-pill);
  font-size: 28rpx;
}
.search-bar__clear { font-size: 26rpx; color: var(--c-accent); }

.filters {
  white-space: nowrap;
  padding: 0 var(--space-edge) 16rpx;
}
.filters .seg-sticker--chip {
  margin-right: 12rpx;
  background: var(--c-surface);
}
.filters .seg-sticker--chip.is-on {
  background: var(--c-accent-soft);
}

.otd-strip {
  white-space: nowrap;
  padding: 0 var(--space-edge) 20rpx;
}
.otd-strip__label {
  display: inline-block;
  vertical-align: top;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--c-accent-deep);
  font-weight: 600;
  margin-right: 16rpx;
  padding-top: 56rpx;
}
.otd-ticket {
  display: inline-block;
  vertical-align: top;
  width: 200rpx;
  margin-right: 14rpx;
  padding: 12rpx;
  background: var(--c-surface);
  border-radius: 12rpx;
  box-shadow: var(--c-shadow);
  border: 1rpx solid var(--c-divider);
  transform: rotate(-2deg);
}
.otd-ticket:nth-child(even) { transform: rotate(1.5deg); }
.otd-ticket__no {
  display: block;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--c-accent);
  margin-bottom: 8rpx;
}
.otd-ticket__img {
  width: 100%;
  height: 120rpx;
  border-radius: 8rpx;
  display: block;
}
.otd-ticket__date {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-muted);
}
.otd-ticket__cap {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reel-stream {
  padding: 8rpx 0 0;
}

.reel-month {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx var(--space-edge) 16rpx;
}
.reel-month__line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--c-accent-soft), transparent);
}
.reel-month__text {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--c-accent-deep);
  font-weight: 600;
}

.reel-milestone {
  margin: 8rpx var(--space-edge) 20rpx;
  padding: 24rpx;
  text-align: center;
  border-radius: var(--r-card);
  background: linear-gradient(135deg, rgba(212, 165, 116, 0.22), rgba(139, 126, 200, 0.14));
  border: 1rpx dashed rgba(139, 126, 200, 0.35);
}
.reel-milestone__star {
  display: block;
  font-size: 28rpx;
  color: var(--c-accent);
}
.reel-milestone__title {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.reel-milestone__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-muted);
}

/* —— 胶片片段卡片 —— */
.scene {
  display: flex;
  align-items: stretch;
  padding: 0 8rpx 28rpx;
  margin-bottom: 4rpx;
}
.scene--a .scene__cell { transform: translateX(0); }
.scene--b .scene__cell { transform: translateX(8rpx); }

.scene__sprocket {
  width: 20rpx;
  flex-shrink: 0;
  background-image: radial-gradient(circle at center, rgba(110, 98, 168, 0.2) 28%, transparent 32%);
  background-size: 20rpx 28rpx;
  background-repeat: repeat-y;
  opacity: 0.65;
}

.scene__cell {
  flex: 1;
  min-width: 0;
  position: relative;
  padding: 20rpx 20rpx 18rpx;
  background: var(--c-surface);
  border-radius: 20rpx;
  box-shadow:
    0 16rpx 40rpx rgba(110, 98, 168, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(139, 126, 200, 0.12);
  overflow: hidden;
  transition: transform 0.25s ease;
}
.scene--you .scene__cell {
  border-left: 4rpx solid var(--c-you);
}
.scene--them .scene__cell {
  border-left: 4rpx solid var(--c-them);
}

.scene__watermark {
  position: absolute;
  right: 12rpx;
  top: 8rpx;
  font-size: 96rpx;
  font-weight: 700;
  color: rgba(139, 126, 200, 0.07);
  line-height: 1;
  pointer-events: none;
  font-family: Georgia, 'Times New Roman', serif;
}

.scene__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}
.scene__index {
  display: block;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--c-accent);
  font-weight: 600;
}
.scene__author {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.scene__head-right { text-align: right; }
.scene__md {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.scene__dow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--c-muted);
  margin-top: 2rpx;
}

/* 影院：大图 + 字叠在画面上 */
.scene__cinema {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  min-height: 280rpx;
  background: linear-gradient(145deg, #2a2438, #1a1820);
}
.scene__cinema-img {
  width: 100%;
  height: 400rpx;
  display: block;
}
.scene__cinema-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(180deg, transparent, rgba(26, 24, 32, 0.88));
  pointer-events: none;
}
.scene__cinema-badges {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  z-index: 2;
}
.scene__badge {
  padding: 6rpx 14rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 6rpx;
  backdrop-filter: blur(8px);
}
.scene__cinema-cap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 48rpx 20rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #fff;
  z-index: 2;
}
.scene__cinema--empty {
  min-height: 200rpx;
  padding: 80rpx 20rpx 24rpx;
}
.scene__cinema-cap--static {
  position: relative;
  padding: 16rpx 0 0;
  color: rgba(255, 255, 255, 0.92);
}

/* Bento 不对称拼贴 */
.scene__bento {
  position: relative;
  display: grid;
  gap: 8rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.scene__bento--2 {
  grid-template-columns: 1.2fr 0.8fr;
  grid-template-rows: 240rpx;
}
.scene__bento--3 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 200rpx 160rpx;
}
.scene__bento--3 .scene__bento-cell--0 {
  grid-column: 1 / 3;
}
.scene__bento--4 {
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 180rpx 180rpx;
}
.scene__bento-cell {
  position: relative;
  overflow: hidden;
  background: var(--c-surface-soft);
}
.scene__bento-img {
  width: 100%;
  height: 100%;
  min-height: 120rpx;
  display: block;
}
.scene__bento-cap {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--c-text);
}

/* 横向胶片条（多图） */
.scene__filmstrip {
  margin: 0 -4rpx;
}
.scene__filmstrip-inner {
  display: inline-flex;
  gap: 10rpx;
  padding: 4rpx 4rpx 12rpx;
  white-space: nowrap;
}
.scene__frame-thumb {
  width: 200rpx;
  height: 260rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 24rpx rgba(74, 68, 88, 0.2);
  transform: rotate(-1deg);
}
.scene__frame-thumb:nth-child(even) { transform: rotate(1.2deg); }
.scene__frame-thumb image {
  width: 100%;
  height: 100%;
  display: block;
}
.scene__frame-more {
  width: 120rpx;
  height: 260rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--c-accent-soft);
  color: var(--c-accent-deep);
  font-size: 32rpx;
  font-weight: 600;
}
.scene__filmstrip-cap {
  display: block;
  padding: 0 4rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--c-text);
}

/* 纯文字诗卡 */
.scene__verse {
  padding: 32rpx 28rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, var(--c-surface-soft), rgba(255, 255, 255, 0.9));
  border: 1rpx solid var(--c-divider);
}
.scene__verse-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--c-text);
  font-weight: 500;
}
.scene__verse-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--c-accent);
}

.scene__signal {
  padding: 28rpx 8rpx;
  position: relative;
  z-index: 1;
}
.scene__signal-badge {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--c-accent-deep);
  font-weight: 600;
}
.scene__signal-text {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.scene__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--c-muted);
  position: relative;
  z-index: 1;
}
.scene__tag {
  color: var(--c-accent);
  font-weight: 500;
}
.scene__loc::before { content: '📍 '; }

.scene__pulse {
  display: flex;
  gap: 24rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--c-divider);
  position: relative;
  z-index: 1;
}
.scene__pulse-item {
  font-size: 24rpx;
  color: var(--c-muted);
  letter-spacing: 1rpx;
}
.scene__pulse-item.is-on { color: #c45c6a; }

.map-panel { padding: 0 var(--space-edge) 40rpx; }
.map-panel__map {
  width: 100%;
  height: 520rpx;
  border-radius: var(--r-card);
}
.map-cities {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.map-cities__title { font-size: 26rpx; color: var(--c-muted); }
.map-cities__chip {
  padding: 8rpx 16rpx;
  background: var(--c-surface);
  border-radius: var(--r-pill);
  font-size: 24rpx;
}

.collections-panel,
.recap-panel { padding: 0 var(--space-edge) 48rpx; }
.panel-title {
  display: block;
  margin: 24rpx 0 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.coll-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.coll-card {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  background: var(--c-surface);
  border-radius: var(--r-card);
  box-shadow: var(--c-shadow);
}
.coll-card__label { font-size: 30rpx; font-weight: 600; }
.coll-card__count { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--c-muted); }
.place-list {
  background: var(--c-surface);
  border-radius: var(--r-card);
  overflow: hidden;
}
.place-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--c-divider);
}
.place-row__n { color: var(--c-muted); }
.empty-hint {
  padding: 32rpx;
  text-align: center;
  color: var(--c-muted);
  font-size: 26rpx;
}

.recap-year { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.recap-months { white-space: nowrap; margin-bottom: 20rpx; }
.recap-month {
  display: inline-block;
  padding: 12rpx 20rpx;
  margin-right: 10rpx;
  border-radius: var(--r-pill);
  background: var(--c-surface);
  font-size: 26rpx;
  color: var(--c-muted);
}
.recap-month.is-on {
  background: var(--c-accent-soft);
  color: var(--c-accent-deep);
  font-weight: 600;
}
.recap-stats { padding: 28rpx; }
.recap-stats__main { display: block; font-size: 32rpx; font-weight: 600; }
.recap-stats__row {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--c-muted);
}
.recap-stats__tag {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-accent);
}

.load-more {
  text-align: center;
  padding: 40rpx 0 48rpx;
  color: var(--c-muted);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.load-more--hint { color: var(--c-accent); }

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 10;
}
