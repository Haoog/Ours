<view class="page grain reel-page" style="{{themeStyle}}">
  <view class="reel-hero fade-in">
    <view class="reel-hero__top">
      <text class="reel-hero__tag tag tag--accent">我们的回忆</text>
    </view>
    <text class="reel-hero__title serif">回忆</text>
    <text class="reel-hero__sub" wx:if="{{briefStats.total > 0}}">{{briefStats.total}} 条回忆 · 慢慢翻看你们走过的日子</text>
    <text class="reel-hero__sub" wx:else>把日子留成片段，慢慢翻看</text>
  </view>

  <view class="view-tabs card-soft seg-strip">
    <view class="seg-sticker {{viewMode === 'timeline' ? 'is-on' : ''}}" data-mode="timeline" bindtap="onSwitchView">回忆</view>
    <view class="seg-sticker {{viewMode === 'map' ? 'is-on' : ''}}" data-mode="map" bindtap="onSwitchView">足迹</view>
    <view class="seg-sticker {{viewMode === 'collections' ? 'is-on' : ''}}" data-mode="collections" bindtap="onSwitchView">合辑</view>
    <view class="seg-sticker {{viewMode === 'recap' ? 'is-on' : ''}}" data-mode="recap" bindtap="onSwitchView">回顾</view>
  </view>

  <view class="search-bar" wx:if="{{viewMode === 'timeline'}}">
    <input
      class="search-bar__input"
      placeholder="搜索回忆文字…"
      value="{{searchKeyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm" />
    <text wx:if="{{searchActive}}" class="search-bar__clear" bindtap="onClearSearch">清除</text>
  </view>

  <view class="context-filter" wx:if="{{viewMode === 'timeline' && contextLabel}}">
    <text>{{contextLabel}}</text>
    <view bindtap="onClearContext">清除 ×</view>
  </view>
  <view wx:if="{{viewMode !== 'timeline' && secondaryError}}" class="err-banner" bindtap="onRetrySecondary">
    <text>{{secondaryError}}</text>
    <text class="err-banner__retry">重试</text>
  </view>
  <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{viewMode === 'timeline'}}">
    <view
      class="seg-sticker seg-sticker--chip {{filterTag === item.key ? 'is-on' : ''}}"
      wx:for="{{tagFilters}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onPickFilter">{{item.label}}</view>
  </scroll-view>

  <scroll-view
    class="otd-strip"
    scroll-x
    enhanced
    show-scrollbar="{{false}}"
    wx:if="{{viewMode === 'timeline' && onThisDay.length && !searchActive}}">
    <text class="otd-strip__label">那年今日</text>
    <view
      class="otd-ticket"
      wx:for="{{onThisDay}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapScene">
      <text class="otd-ticket__no">#{{item.sceneNo}}</text>
      <view class="otd-ticket__media" wx:if="{{item.coverUrl || item.hasVideo}}">
        <image wx:if="{{item.coverUrl}}" class="otd-ticket__img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
        <view wx:else class="otd-ticket__placeholder">
          <text class="otd-ticket__placeholder-icon">▶</text>
          <text>视频记录</text>
        </view>
        <view wx:if="{{item.hasVideo && item.coverUrl}}" class="otd-ticket__play">▶</view>
        <view wx:if="{{item.hasVideo}}" class="otd-ticket__badge">视频</view>
      </view>
      <text class="otd-ticket__date">{{item.md}}</text>
      <text class="otd-ticket__cap">{{item.content || '…'}}</text>
    </view>
  </scroll-view>

  <block wx:if="{{viewMode === 'timeline'}}">
    <view class="reel-stream" wx:if="{{!empty}}">
      <block wx:for="{{rows}}" wx:key="key">
        <view class="reel-month" wx:if="{{item.type === 'month'}}">
          <view class="reel-month__line"></view>
          <text class="reel-month__text">{{item.label}}</text>
          <view class="reel-month__line"></view>
        </view>

        <view class="reel-milestone" wx:elif="{{item.type === 'milestone'}}">
          <text class="reel-milestone__star">✦</text>
          <text class="reel-milestone__title">{{item.title}}</text>
          <text class="reel-milestone__sub">{{item.sub}}</text>
        </view>

        <view
          wx:elif="{{item.type === 'moment'}}"
          class="scene scene--{{item.scene.stagger}} scene--{{item.scene.role === 'A' ? 'you' : 'them'}}"
          data-id="{{item.scene.id}}"
          bindtap="onTapScene">
          <view class="scene__sprocket scene__sprocket--l"></view>

          <view class="scene__cell">
            <text class="scene__watermark">#{{item.scene.sceneNo}}</text>

            <block wx:if="{{item.scene.layout === 'signal'}}">
              <view class="scene__signal">
                <text class="scene__signal-badge">特别记录</text>
                <text class="scene__signal-text">{{item.scene.content}}</text>
              </view>
            </block>

            <block wx:else>
              <view class="scene__head">
                <view class="scene__head-left">
                  <text class="scene__index">回忆 #{{item.scene.sceneNo}}</text>
                  <text class="scene__author role-{{item.scene.role === 'A' ? 'you' : 'them'}}">{{item.scene.author}}</text>
                </view>
                <view class="scene__head-right">
                  <text class="scene__md">{{item.scene.md}}</text>
                  <text class="scene__dow">{{item.scene.dow}}</text>
                </view>
              </view>

              <view class="scene__cinema {{item.scene.coverUrl ? '' : 'scene__cinema--empty'}}" wx:if="{{item.scene.layout === 'cinema'}}">
                <image
                  wx:if="{{item.scene.coverUrl}}"
                  class="scene__cinema-img"
                  src="{{item.scene.coverUrl}}"
                  mode="aspectFill"
                  lazy-load />
                <view wx:else class="scene__cinema-empty">
                  <text class="scene__cinema-empty-icon">{{item.scene.hasVideo ? '▶' : '•••'}}</text>
                  <text>{{item.scene.hasVideo ? '视频记录' : '媒体记录'}}</text>
                </view>
                <view wx:if="{{item.scene.hasVideo && item.scene.coverUrl}}" class="scene__cinema-play">▶</view>
                <view class="scene__cinema-badges">
                  <text wx:if="{{item.scene.hasLive}}" class="scene__badge">实况</text>
                  <text wx:if="{{item.scene.hasVideo}}" class="scene__badge">视频</text>
                  <text wx:if="{{item.scene.hasVoice}}" class="scene__badge">语音 {{item.scene.voiceDuration}}″</text>
                </view>
              </view>

              <view class="scene__bento scene__bento--{{item.scene.bentoClass}}" wx:elif="{{item.scene.layout === 'collage'}}">
                <view
                  class="scene__bento-cell scene__bento-cell--{{index}}"
                  wx:for="{{item.scene.previewImages}}"
                  wx:for-item="src"
                  wx:key="*this">
                  <image class="scene__bento-img" src="{{src}}" mode="aspectFill" lazy-load />
                  <view wx:if="{{index === 0 && item.scene.hasVideo}}" class="scene__bento-video-mark">▶ 视频</view>
                </view>
              </view>

              <scroll-view
                class="scene__filmstrip"
                scroll-x
                enhanced
                show-scrollbar="{{false}}"
                wx:elif="{{item.scene.layout === 'reel'}}">
                <view class="scene__filmstrip-inner">
                  <view
                    class="scene__frame-thumb"
                    wx:for="{{item.scene.previewImages}}"
                    wx:for-item="src"
                    wx:key="*this">
                    <image src="{{src}}" mode="aspectFill" lazy-load />
                    <view wx:if="{{index === 0 && item.scene.hasVideo}}" class="scene__frame-video-mark">▶ 视频</view>
                  </view>
                  <view class="scene__frame-more" wx:if="{{item.scene.imageCount > item.scene.previewImages.length}}">
                    +{{item.scene.imageCount - item.scene.previewImages.length}}
                  </view>
                </view>
              </scroll-view>

              <view class="scene__verse" wx:elif="{{item.scene.layout === 'verse'}}">
                <text class="scene__verse-text {{item.scene.content.length > 180 && !expandedTexts[item.scene.id] ? 'text-collapsed' : ''}}">{{item.scene.content || '（这一格只有沉默）'}}</text>
                <text wx:if="{{item.scene.content.length > 180}}" class="text-expand" data-id="{{item.scene.id}}" catchtap="onExpandText">{{expandedTexts[item.scene.id] ? '收起' : '展开'}}</text>
                <view class="scene__verse-badges" wx:if="{{item.scene.hasVideo || item.scene.hasLive || item.scene.hasVoice}}">
                  <text wx:if="{{item.scene.hasLive}}">实况</text>
                  <text wx:if="{{item.scene.hasVideo}}">视频</text>
                  <text wx:if="{{item.scene.hasVoice}}">语音</text>
                </view>
              </view>

              <view
                class="scene__caption"
                wx:if="{{item.scene.content && item.scene.layout !== 'verse' && item.scene.layout !== 'signal'}}">
                <text class="scene__caption-text {{item.scene.content.length > 180 && !expandedTexts[item.scene.id] ? 'text-collapsed' : ''}}">{{item.scene.content}}</text>
                <text wx:if="{{item.scene.content.length > 180}}" class="text-expand" data-id="{{item.scene.id}}" catchtap="onExpandText">{{expandedTexts[item.scene.id] ? '收起' : '展开'}}</text>
              </view>

              <view class="scene__meta">
                <text wx:if="{{item.scene.tagLabel}}" class="scene__tag">{{item.scene.tagLabel}}</text>
                <text wx:if="{{item.scene.location}}" class="scene__loc">{{item.scene.location}}</text>
              </view>

              <view class="scene__pulse">
                <text
                  class="scene__pulse-item scene__pulse-like {{item.scene.likedByMe ? 'is-on' : ''}}"
                  data-id="{{item.scene.id}}"
                  data-index="{{index}}"
                  catchtap="onToggleSceneLike">
                  {{item.scene.likedByMe ? '♥' : '♡'}}<text wx:if="{{item.scene.likeCount > 0}}"> {{item.scene.likeCount}}</text>
                </text>
                <text class="scene__pulse-item">
                  ◦<text wx:if="{{item.scene.commentCount > 0}}"> {{item.scene.commentCount}}</text> 评论
                </text>
              </view>
            </block>
          </view>

          <view class="scene__sprocket scene__sprocket--r"></view>
        </view>
      </block>

      <view class="load-more" wx:if="{{loadingMore}}">加载中…</view>
      <view class="load-more" wx:elif="{{!hasMore}}">故事暂时翻到这里</view>
      <view class="load-more load-more--hint" wx:else>上拉加载更多</view>
    </view>

    <view wx:elif="{{loading}}" class="reel-skeleton">
      <view class="sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-row">
          <view class="sk-line sk-line--head"></view>
          <view class="sk-line sk-line--date"></view>
        </view>
        <view class="sk-thumb"></view>
        <view class="sk-line"></view>
        <view class="sk-line sk-line--short"></view>
      </view>
    </view>

    <view wx:elif="{{loadError}}" class="err-banner card-soft" hover-class="u-press" bindtap="onRetry">
      <text>{{loadError}}</text>
      <text class="err-banner__retry">点此重试</text>
    </view>

    <view wx:else class="empty-stage">
      <text class="key">{{searchActive ? '没搜到' : '还没有回忆'}}</text>
      <text wx:if="{{!searchActive}}">写下第一段回忆吧</text>
      <view wx:if="{{!searchActive}}" style="margin-top:40rpx; display:flex; justify-content:center;">
        <view class="sticker-send" hover-class="u-press" bindtap="onTapCompose">记一条</view>
      </view>
    </view>

    <view class="fab" hover-class="u-press" bindtap="onTapCompose" wx:if="{{!empty && !searchActive}}">
      <view class="fab-sticker">+</view>
    </view>
  </block>

  <view class="map-panel" wx:if="{{viewMode === 'map'}}">
    <view wx:if="{{secondaryLoading && mapEmpty}}" class="load-more">加载足迹…</view>
    <view wx:elif="{{mapEmpty && !secondaryError}}" class="map-empty card-soft">
      <view class="map-empty__seal">✦</view>
      <text class="map-empty__title serif">故事还没走到地图上</text>
      <text class="map-empty__sub">在写回忆时选一个地点，<br />这里就会亮起你们的第一站。</text>
    </view>

    <block wx:elif="{{!mapEmpty}}">
      <view class="map-panel__intro">
        <view class="map-panel__kicker"><text>✦</text><text>我们的足迹</text></view>
        <text class="map-panel__title serif">我们的足迹</text>
        <text class="map-panel__sub">每一个地点，都藏着一段只属于你们的时间。</text>
      </view>

      <view class="map-panel__stats card-soft">
        <view class="map-panel__stat"><text>{{mapPlaceCount}}</text><text>个地点</text></view>
        <view class="map-panel__stat-divider"></view>
        <view class="map-panel__stat"><text>{{mapMemoryCount}}</text><text>段回忆</text></view>
        <view class="map-panel__stat-divider"></view>
        <view class="map-panel__stat"><text>{{mapCityCount}}</text><text>座城市</text></view>
      </view>

      <view class="map-panel__map-wrap card-soft">
        <footprint-map places="{{places}}" selected-id="{{selectedMapPlaceId}}" theme-id="{{themeId}}" bindselect="onSelectMapPlace" />
        <view class="map-panel__stamp"><text>♥</text><text>一起走过</text></view>
        <view class="map-panel__hint">点一点地图上的足迹</view>
      </view>

      <view class="map-place-section">
        <view class="map-place-section__head">
          <view><text class="map-place-section__title">地点故事</text><text class="map-place-section__sub">从地图上选一站</text></view>
          <text class="map-place-section__count">{{mapPlaceCount}} 站</text>
        </view>
        <scroll-view class="map-place-chips" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{places}}"
            wx:key="id"
            class="map-place-chip {{selectedMapPlaceId === item.id ? 'is-on' : ''}}"
            data-id="{{item.id}}"
            hover-class="u-press"
            bindtap="onTapMapPlace">
            <text class="map-place-chip__mark">♥</text>
            <text class="map-place-chip__name">{{item.name}}</text>
            <text class="map-place-chip__count">{{item.momentCount}}</text>
          </view>
        </scroll-view>

        <view wx:if="{{selectedMapPlace}}" class="map-story card-soft" hover-class="u-press" bindtap="onTapMapStory">
          <view class="map-story__media">
            <image wx:if="{{selectedMapPlace.latestMomentCover}}" class="map-story__image" src="{{selectedMapPlace.latestMomentCover}}" mode="aspectFill" lazy-load />
            <view wx:else class="map-story__placeholder">
              <text>{{selectedMapPlace.latestMomentHasVideo ? '▶' : '✦'}}</text>
              <text>{{selectedMapPlace.latestMomentHasVideo ? '一段视频回忆' : '这一站，留下过回忆'}}</text>
            </view>
            <view wx:if="{{selectedMapPlace.latestMomentHasVideo}}" class="map-story__tag">视频</view>
          </view>
          <view class="map-story__body">
            <view class="map-story__title-row">
              <text class="map-story__title">{{selectedMapPlace.name}}</text>
              <text class="map-story__total">{{selectedMapPlace.momentCount}} 条回忆</text>
            </view>
            <text wx:if="{{selectedMapPlace.address}}" class="map-story__address">{{selectedMapPlace.address}}</text>
            <text class="map-story__content">{{selectedMapPlace.latestMomentContent || (selectedMapPlace.latestMomentHasVideo ? '一段视频，等你回看。' : '这一站，也被你们好好记住了。')}}</text>
            <view class="map-story__foot">
              <text>{{selectedMapPlace.latestMomentDate ? '最近记录 · ' + selectedMapPlace.latestMomentDate : '最近留下的回忆'}}</text>
              <text wx:if="{{selectedMapPlace.latestMomentId}}" class="map-story__open">打开回忆 →</text>
            </view>
          </view>
        </view>
      </view>

      <view class="place-all" bindtap="onOpenMapPlace">查看这一站的全部回忆 →</view>
      <view class="map-cities" wx:if="{{cities.length}}">
        <view class="map-cities__head"><text class="map-cities__title">城市小记</text><text>你们的故事正在变多</text></view>
        <scroll-view class="map-cities__list" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="map-cities__chip" wx:for="{{cities}}" wx:key="name"><text>{{item.name}}</text><text> {{item.count}} 次</text></view>
        </scroll-view>
      </view>
    </block>
  </view>

  <view class="collections-panel" wx:if="{{viewMode === 'collections'}}">
    <view wx:if="{{secondaryLoading}}" class="load-more">加载合辑…</view>
    <view class="collections-hero card-soft">
      <view class="collections-hero__copy">
        <text class="collections-hero__eyebrow">整理你们的故事</text>
        <text class="collections-hero__title">把回忆放进喜欢的主题</text>
        <text class="collections-hero__sub">按标签或地点，回到某一种心情。</text>
      </view>
      <view class="collections-hero__stamp">
        <text class="collections-hero__stamp-number">{{collections.tags.length}}</text>
        <text class="collections-hero__stamp-label">个主题</text>
      </view>
    </view>

    <view class="collection-section-head">
      <view class="collection-section-head__copy">
        <text class="collection-section-head__title">主题合辑</text>
        <text class="collection-section-head__sub">每一种标签，都是一种语气</text>
      </view>
      <text class="collection-section-head__count">{{collectionTagTotal}} 条</text>
    </view>
    <view class="coll-grid" wx:if="{{collections.tags.length}}">
      <view
        class="coll-card coll-card--{{item.tone}}"
        wx:for="{{collections.tags}}"
        wx:key="key"
        data-key="{{item.key}}"
        hover-class="u-press"
        bindtap="onTapCollectionTag">
        <view class="coll-card__top">
          <view class="coll-card__icon">{{item.icon}}</view>
          <view class="coll-card__copy">
            <text class="coll-card__label">{{item.label}}</text>
            <text class="coll-card__count">{{item.count}} 条回忆</text>
          </view>
          <text class="coll-card__arrow">↗</text>
        </view>
        <view class="coll-card__bar"><view class="coll-card__bar-fill" style="width: {{item.percent}}%;"></view></view>
        <text class="coll-card__hint">打开这组回忆</text>
      </view>
    </view>
    <view wx:else class="collection-empty card-soft">
      <text class="collection-empty__icon">✦</text>
      <text class="collection-empty__title">还没有主题合辑</text>
      <text class="collection-empty__sub">给回忆加一个标签，它们就会在这里聚起来。</text>
    </view>

    <view class="collection-section-head collection-section-head--places">
      <view class="collection-section-head__copy">
        <text class="collection-section-head__title">地点合辑</text>
        <text class="collection-section-head__sub">那些一起抵达过的地方</text>
      </view>
      <text class="collection-section-head__count">{{collectionPlaceTotal}} 条</text>
    </view>
    <view class="place-list" wx:if="{{collections.places.length}}">
      <view
        class="place-row"
        wx:for="{{collections.places}}"
        wx:key="name"
        data-name="{{item.name}}"
        hover-class="u-press"
        bindtap="onTapCollectionPlace">
        <view class="place-row__rank">{{item.rank}}</view>
        <view class="place-row__copy">
          <view class="place-row__top">
            <text class="place-row__name">{{item.name}}</text>
            <text class="place-row__n">{{item.count}} 条</text>
          </view>
          <view class="place-row__bar"><view class="place-row__bar-fill" style="width: {{item.percent}}%;"></view></view>
        </view>
        <text class="place-row__arrow">→</text>
      </view>
    </view>
    <view wx:else class="collection-empty collection-empty--small card-soft">
      <text class="collection-empty__title">还没有地点合辑</text>
      <text class="collection-empty__sub">写回忆时选一个地点，这里会自动整理。</text>
    </view>
  </view>

  <view class="recap-panel" wx:if="{{viewMode === 'recap'}}">
    <picker mode="selector" range="{{recapYears}}" bindchange="onPickRecapYear">
      <view class="recap-year">{{recapYear}} 年 ▾</view>
    </picker>
    <view class="recap-cover card-soft">
      <view class="recap-cover__copy">
        <text class="recap-cover__eyebrow">这一月的回忆</text>
        <text class="recap-cover__title">把这个月，慢慢看一遍</text>
        <text class="recap-cover__sub">{{recapYear}} 年 {{recapMonth}} 月 · 你们留下的日子</text>
      </view>
      <view class="recap-cover__stamp">
        <text class="recap-cover__number" wx:if="{{recapStats}}">{{recapStats.total}}</text>
        <text class="recap-cover__number" wx:else>—</text>
        <text class="recap-cover__label">条回忆</text>
      </view>
    </view>

    <view class="collection-section-head recap-section-head">
      <view class="collection-section-head__copy">
        <text class="collection-section-head__title">选择月份</text>
        <text class="collection-section-head__sub">看看哪一段日子最想回去</text>
      </view>
      <text class="collection-section-head__count">{{recapMonth}} 月</text>
    </view>
    <scroll-view class="recap-months" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        class="recap-month {{recapMonth === item ? 'is-on' : ''}}"
        wx:for="{{recapMonths}}"
        wx:key="*this"
        data-month="{{item}}"
        bindtap="onRecapMonthTap">
        <text class="recap-month__number">{{item}}</text>
        <text class="recap-month__label">月</text>
      </view>
    </scroll-view>

    <view class="recap-stats card-soft" wx:if="{{recapStats && recapStats.total > 0}}">
      <view class="recap-stats__head">
        <view>
          <text class="recap-stats__title">{{recapMonth}} 月的记录</text>
          <text class="recap-stats__sub">每一次留下，都会变成你们的时间</text>
        </view>
        <text class="recap-stats__mark">✦</text>
      </view>
      <view class="recap-metrics">
        <view class="recap-metric recap-metric--primary">
          <text class="recap-metric__value">{{recapStats.total}}</text>
          <text class="recap-metric__label">条回忆</text>
        </view>
        <view class="recap-metric">
          <text class="recap-metric__value">{{myRole === 'A' ? recapStats.countA : recapStats.countB}}</text>
          <text class="recap-metric__label">我写下</text>
        </view>
        <view class="recap-metric">
          <text class="recap-metric__value">{{myRole === 'A' ? recapStats.countB : recapStats.countA}}</text>
          <text class="recap-metric__label">TA 写下</text>
        </view>
        <view class="recap-metric">
          <text class="recap-metric__value">{{recapStats.placeCount}}</text>
          <text class="recap-metric__label">个地点</text>
        </view>
      </view>
      <view class="recap-share">
        <view class="recap-share__bar">
          <view class="recap-share__bar-a" style="width: {{recapStats.percentA}}%;"></view>
          <view class="recap-share__bar-b" style="width: {{recapStats.percentB}}%;"></view>
        </view>
        <view class="recap-share__legend">
          <text><text class="recap-share__dot recap-share__dot--a"></text>{{myRole === 'A' ? '我' : 'TA'}} {{recapStats.countA}}</text>
          <text><text class="recap-share__dot recap-share__dot--b"></text>{{myRole === 'B' ? '我' : 'TA'}} {{recapStats.countB}}</text>
        </view>
      </view>
      <view class="recap-tone" wx:if="{{recapStats.topTag !== '—'}}">
        <text class="recap-tone__label">本月主调</text>
        <text class="recap-tone__value">{{recapStats.topTag}}</text>
      </view>
    </view>
    <view wx:elif="{{recapStats}}" class="recap-empty card-soft">
      <text class="recap-empty__icon">☼</text>
      <text class="recap-empty__title">这个月还很安静</text>
      <text class="recap-empty__sub">留下一条回忆，给 {{recapMonth}} 月添一点颜色。</text>
      <view class="recap-empty__action" hover-class="u-press" bindtap="onTapCompose">记一条 →</view>
    </view>
    <view wx:else class="recap-empty card-soft">
      <text class="recap-empty__title">{{recapLoading ? '正在翻看这一页…' : '暂时没有加载成功'}}</text>
    </view>
    <view class="recap-photo-grid" wx:if="{{recapMemories.length}}">
      <view wx:for="{{recapMemories}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapScene">
        <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
        <view wx:else class="recap-photo-placeholder">{{item.content || '一段回忆'}}</view>
        <text>{{item.md}}</text>
      </view>
    </view>
    <view class="place-all" wx:if="{{recapStats && recapStats.total > 0}}" bindtap="onOpenRecap">查看当月全部回忆 →</view>
  </view>

</view>
