.page {
  min-height: 100vh;
  padding: 28rpx var(--space-edge) calc(48rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
}

.head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 20rpx;
}
.head__cat { margin-bottom: 4rpx; display: flex; }
.head__title { font-size: 40rpx; font-weight: 600; color: var(--c-text); }
.head__sub { font-size: 24rpx; color: var(--c-muted); }

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
}
.month-nav__btn {
  font-size: 40rpx;
  color: var(--c-accent-deep);
  padding: 0 16rpx;
}
.month-nav__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}

.stats {
  margin: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--c-muted);
  padding: 0 8rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}
.legend__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--c-muted);
}
.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.dot--both { background: var(--c-accent); }
.dot--me { background: var(--c-you); }
.dot--partner { background: var(--c-them); }

.calendar { padding: 20rpx 16rpx 28rpx; }
.calendar__week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
}
.calendar__wd {
  text-align: center;
  font-size: 22rpx;
  color: var(--c-muted);
}
.calendar__grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.calendar__cell {
  aspect-ratio: 1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--c-surface-soft);
}
.calendar__cell.is-empty {
  background: transparent;
}
.calendar__day {
  font-size: 26rpx;
  color: var(--c-text);
}
.status-both {
  background: rgba(139, 126, 200, 0.35);
  box-shadow: inset 0 0 0 2rpx var(--c-accent);
}
.status-me {
  background: rgba(123, 140, 181, 0.28);
}
.status-partner {
  background: rgba(155, 142, 207, 0.28);
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(74, 68, 88, 0.35);
  z-index: 20;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  background: var(--c-surface);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx var(--space-edge) calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(110, 98, 168, 0.15);
}
.sheet__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.sheet__title { font-size: 32rpx; font-weight: 600; }
.sheet__close { font-size: 26rpx; color: var(--c-accent-deep); }
.sheet__lines { display: flex; flex-direction: column; gap: 16rpx; }
.sheet__line {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.6;
}
