<view class="page grain">
  <view class="poster fade-in card-soft">
    <view class="poster__cat">
      <kitty-face size="lg" mood="awake" />
    </view>
    <text class="poster__tag tag tag--accent">邀请她</text>
    <text class="poster__title serif">{{youName}} &amp; {{themName}}</text>
    <text class="poster__sub">从 {{startDate}} 起，一起使用 Ours</text>
  </view>

  <view class="steps">
    <view class="step card-soft">
      <text class="step__no">1</text>
      <text class="step__text">点击下方按钮分享给她</text>
    </view>
    <view class="step card-soft">
      <text class="step__no">2</text>
      <text class="step__text">她打开卡片即可加入</text>
    </view>
    <view class="step card-soft">
      <text class="step__no">3</text>
      <text class="step__text">记录只属于你们两个人</text>
    </view>
  </view>

  <button open-type="share" class="share-btn">分享给她</button>
  <text class="note cat-paw">🐾 她（{{partnerHint}}）也可直接打开小程序自动加入；分享卡片同样有效</text>

  <pet-float />
</view>
