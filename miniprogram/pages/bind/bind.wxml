<view class="page grain" style="{{themeStyle}}">
  <view class="poster fade-in card-soft">
    <text class="poster__tag tag tag--accent">邀请她</text>
    <text class="poster__title serif">{{youName}} &amp; {{themName}}</text>
    <text class="poster__sub">从 {{startDate}} 起，一起使用 Ours</text>
  </view>

  <view class="steps">
    <view class="step card-soft">
      <text class="step__no">1</text>
      <text class="step__text">点击下方按钮分享给她</text>
    </view>
    <view class="step card-soft">
      <text class="step__no">2</text>
      <text class="step__text">她打开卡片即可加入</text>
    </view>
    <view class="step card-soft">
      <text class="step__no">3</text>
      <text class="step__text">记录只属于你们两个人</text>
    </view>
  </view>

  <text wx:if="{{inviteError}}" class="note">{{inviteError}}</text>
  <text wx:if="{{inviteLoading}}" class="note">正在准备邀请链接…</text>
  <block wx:elif="{{inviteAvailable}}">
    <block wx:if="{{inviteReady}}">
      <button open-type="share" class="share-btn">分享给她</button>
      <button class="btn-action btn-action--ghost note" bindtap="onGenerateInvite">重新生成链接</button>
    </block>
    <button wx:else class="share-btn" bindtap="onGenerateInvite">生成邀请链接</button>
    <text class="note">邀请链接有效期为 7 天，且只能连接一位成员</text>
  </block>
  <button wx:elif="{{inviteError}}" class="share-btn" bindtap="refreshInvite">重试</button>
  <text wx:else class="note">当前空间无需邀请</text>

</view>
