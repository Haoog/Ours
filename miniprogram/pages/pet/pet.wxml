<view class="page grain">
  <view wx:if="{{loading}}" class="empty-stage">
    <text>加载中…</text>
  </view>

  <block wx:elif="{{pet && pet.adopted}}">
    <view class="head fade-in">
      <text class="head__tag tag tag--accent">一起养猫</text>
      <text class="head__title serif">{{pet.name}}</text>
      <text class="head__sub">{{pet.message}}</text>
    </view>

    <view class="stage card-soft">
      <couple-pet pet="{{pet}}" large />
    </view>

    <view class="tips card-soft">
      <text class="tips__line">· 记录回忆会让小猫成长</text>
      <text class="tips__line">· 每天可喂食、抚摸各一次（两人共享）</text>
      <text class="tips__line">· 太久不喂，小猫心情会慢慢下降</text>
    </view>

    <view class="actions">
      <view
        class="pet-sticker pet-sticker--feed {{pet.canFeed ? '' : 'is-off'}}"
        hover-class="u-press"
        data-action="feed"
        bindtap="onInteract">🍙 喂食</view>
      <view
        class="pet-sticker pet-sticker--pet {{pet.canPet ? '' : 'is-off'}}"
        hover-class="u-press"
        data-action="pet"
        bindtap="onInteract">🤍 抚摸</view>
    </view>
  </block>

  <block wx:else>
    <view class="head fade-in">
      <view class="head__kitty"><kitty-face size="lg" mood="awake" /></view>
      <text class="head__tag tag tag--accent">领养小猫</text>
      <text class="head__title serif">带一只白猫回家</text>
      <text class="head__sub">和 Ours 同款小猫，会陪你们一起长大</text>
    </view>

    <view class="name-box card-soft">
      <text class="name-box__label">给它起个名字</text>
      <input
        class="name-box__input"
        placeholder="例如：小咪"
        value="{{nameDraft}}"
        bindinput="onNameInput" />
    </view>

    <view class="actions">
      <view class="pet-sticker pet-sticker--adopt" hover-class="u-press" bindtap="onAdopt">领养小猫</view>
    </view>
  </block>
</view>
