{
  "pages": [
    "pages/setup/setup",
    "pages/home/home",
    "pages/moments/moments",
    "pages/profile/profile",
    "pages/compose/compose",
    "pages/moment-detail/moment-detail",
    "pages/bind/bind",
    "pages/pet/pet"
  ],
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#F5F3FA",
    "navigationBarTitleText": "Ours",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F5F3FA"
  },
  "tabBar": {
    "color": "#9A94A8",
    "selectedColor": "#8B7EC8",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页"
      },
      {
        "pagePath": "pages/moments/moments",
        "text": "回忆"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我们"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.userLocation": {
      "desc": "用于在动态中标记你们一起去过的地方"
    },
    "scope.record": {
      "desc": "用于录制语音日记"
    },
    "scope.camera": {
      "desc": "用于拍摄照片和视频"
    },
    "scope.album": {
      "desc": "用于从相册选择照片和视频"
    }
  },
  "requiredPrivateInfos": [
    "chooseLocation"
  ],
  "usingComponents": {
    "pet-float": "/components/pet-float/pet-float"
  },
  "subpackages": [
    {
      "root": "subpages/",
      "pages": [
        "map/map",
        "anniversaries/anniversaries"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home": {
      "network": "all",
      "packages": ["subpages/"]
    },
    "pages/profile/profile": {
      "network": "all",
      "packages": ["subpages/"]
    }
  }
}
