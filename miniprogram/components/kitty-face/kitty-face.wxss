/* 白猫脸 · Hello Kitty 风格（原创 CSS，蝴蝶结为淡紫色以配合品牌色） */

.kitty {
  position: relative;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 尺寸 */
.kitty--sm { width: 72rpx; height: 68rpx; }
.kitty--md { width: 96rpx; height: 90rpx; }
.kitty--lg { width: 128rpx; height: 120rpx; }

.kitty--sm .kitty__head { width: 56rpx; height: 50rpx; }
.kitty--md .kitty__head { width: 76rpx; height: 68rpx; }
.kitty--lg .kitty__head { width: 100rpx; height: 88rpx; }

/* 蝴蝶结（左耳侧，淡紫） */
.kitty__bow {
  position: absolute;
  left: -2rpx;
  top: 22%;
  z-index: 3;
  display: flex;
  align-items: center;
  width: 36rpx;
  height: 22rpx;
}
.kitty--sm .kitty__bow {
  left: -4rpx;
  top: 18%;
  width: 28rpx;
  height: 18rpx;
}
.kitty--lg .kitty__bow {
  left: 0;
  width: 44rpx;
  height: 26rpx;
}

.kitty__bow-loop {
  width: 14rpx;
  height: 18rpx;
  background: linear-gradient(165deg, #FF7A9A, #E84A6F);
  border-radius: 50% 50% 45% 45%;
  border: 1rpx solid #D63D65;
}
.kitty--sm .kitty__bow-loop { width: 11rpx; height: 14rpx; }
.kitty--lg .kitty__bow-loop { width: 17rpx; height: 21rpx; }

.kitty__bow-loop--l { transform: rotate(-28deg); margin-right: -4rpx; }
.kitty__bow-loop--r { transform: rotate(28deg); margin-left: -4rpx; }

.kitty__bow-knot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #D63D65;
  flex-shrink: 0;
  z-index: 1;
}

/* 圆脸 */
.kitty__head {
  position: relative;
  background: #FFFFFF;
  border-radius: 46% 46% 44% 44%;
  border: 2rpx solid #E6E0F0;
  box-shadow:
    0 6rpx 16rpx rgba(110, 98, 168, 0.12),
    inset 0 -4rpx 8rpx rgba(155, 143, 180, 0.06);
}

/* 耳朵 */
.kitty__ear {
  position: absolute;
  top: -10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #FFFFFF;
  border: 2rpx solid #E6E0F0;
  border-radius: 50% 50% 0 50%;
}
.kitty--sm .kitty__ear { width: 16rpx; height: 16rpx; top: -8rpx; }
.kitty--lg .kitty__ear { width: 26rpx; height: 26rpx; top: -12rpx; }

.kitty__ear--l {
  left: 6rpx;
  transform: rotate(-18deg);
}
.kitty__ear--r {
  right: 6rpx;
  transform: scaleX(-1) rotate(-18deg);
}

/* 眼睛：椭圆黑点，偏上 */
.kitty__eye {
  position: absolute;
  top: 38%;
  width: 8rpx;
  height: 11rpx;
  background: #2D2640;
  border-radius: 50%;
}
.kitty--sm .kitty__eye { width: 6rpx; height: 9rpx; }
.kitty--lg .kitty__eye { width: 10rpx; height: 14rpx; }

.kitty__eye--l { left: 22%; }
.kitty__eye--r { right: 22%; }

/* 鼻子：黄色椭圆，无嘴 */
.kitty__nose {
  position: absolute;
  left: 50%;
  top: 54%;
  transform: translateX(-50%);
  width: 11rpx;
  height: 9rpx;
  background: #F4C430;
  border-radius: 50%;
  border: 1rpx solid #E0AD28;
  box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.5) inset;
}
.kitty--sm .kitty__nose { width: 9rpx; height: 7rpx; }
.kitty--lg .kitty__nose { width: 14rpx; height: 11rpx; }

/* 胡须（极淡，增加辨识度） */
.kitty__whisker {
  position: absolute;
  top: 52%;
  width: 14rpx;
  height: 1rpx;
  background: #D8D0E8;
  border-radius: 1rpx;
}
.kitty--sm .kitty__whisker { width: 10rpx; }
.kitty--lg .kitty__whisker { width: 18rpx; }

.kitty__whisker--l1 { left: 4%; transform: rotate(8deg); }
.kitty__whisker--l2 { left: 6%; top: 58%; transform: rotate(-6deg); }
.kitty__whisker--r1 { right: 4%; transform: rotate(-8deg); }
.kitty__whisker--r2 { right: 6%; top: 58%; transform: rotate(6deg); }

/* 状态 */
.kitty--dim {
  opacity: 0.5;
  filter: saturate(0.75);
}
.kitty--dim .kitty__eye {
  height: 3rpx;
  top: 42%;
  border-radius: 2rpx;
}
.kitty--dim .kitty__bow-loop {
  background: #E8B4C4;
  border-color: #D4A0B0;
}

.kitty--awake .kitty__head {
  animation: kitty-nod 520ms ease;
}

@keyframes kitty-nod {
  0%, 100% { transform: translateY(0) rotate(0); }
  40%      { transform: translateY(-6rpx) rotate(-2deg); }
  70%      { transform: translateY(-2rpx) rotate(1deg); }
}
