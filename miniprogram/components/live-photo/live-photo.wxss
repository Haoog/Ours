.live-photo {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: inherit;
  background: #1a1820;
}
.live-photo__cover,
.live-photo__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.live-photo__badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(var(--c-deep-rgb), 0.88);
  z-index: 2;
}
.live-photo__hint {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  z-index: 2;
}
