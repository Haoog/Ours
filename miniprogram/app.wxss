/* =========================================================
   Ours · 两个人的照片日记
   照片、日期与双人头像为视觉重点
   ========================================================= */

page {
  --c-accent-rgb: 139, 126, 200;
  --c-deep-rgb: 110, 98, 168;
  --c-text-rgb: 74, 68, 88;
  --c-bg:           #F5F3FA;
  --c-surface:      #FFFFFF;
  --c-surface-soft: #EDE9F6;
  --c-accent:       #8B7EC8;
  --c-accent-light: #9B8ECF;
  --c-accent-deep:  #6E62A8;
  --c-accent-soft:  rgba(var(--c-accent-rgb), 0.22);
  --c-you:          #7B8CB5;
  --c-them:         #9B8ECF;
  --c-text:         #4A4458;
  --c-muted:        rgba(var(--c-text-rgb), 0.52);
  --c-divider:      rgba(var(--c-deep-rgb), 0.12);
  --c-shadow:       0 12rpx 36rpx rgba(var(--c-deep-rgb), 0.12);
  --c-accent-gradient: linear-gradient(160deg, #9B8ECF 0%, #6E62A8 100%);
  --c-accent-shadow: rgba(var(--c-deep-rgb), 0.35);
  --c-grain-dot:     rgba(var(--c-accent-rgb), 0.07);

  --c-cinema-black: var(--c-bg);
  --c-film-grey:    var(--c-surface);
  --c-film-grey-2:  var(--c-surface-soft);
  --c-gold:         var(--c-accent);
  --c-gold-soft:    var(--c-accent-soft);
  --c-subtitle:     var(--c-text);

  --r-frame: 16rpx;
  --r-card:  20rpx;
  --r-pill:  999rpx;
  --space-edge: 36rpx;

  --fs-tag:   22rpx;
  --fs-body:  28rpx;
  --fs-quote: 32rpx;
  --fs-title: 52rpx;
  --fs-hero:  104rpx;

  background-color: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--fs-body);
  line-height: 1.65;
}

.grain {
  position: relative;
}
.grain::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.35;
  background-image:
    radial-gradient(var(--c-grain-dot) 1.5rpx, transparent 1.5rpx);
  background-size: 24rpx 24rpx;
}

.letterbox-top,
.letterbox-bottom {
  display: none;
}

.tag {
  font-size: var(--fs-tag);
  letter-spacing: 0.06em;
  color: var(--c-muted);
}
.tag--accent { color: var(--c-accent-deep); }

.slate {
  font-size: var(--fs-tag);
  color: var(--c-muted);
}
.slate--gold { color: var(--c-accent); }

.serif {
  font-family: 'PingFang SC', -apple-system, sans-serif;
  font-weight: 600;
}

.role-you  { color: var(--c-you); }
.role-them { color: var(--c-them); }

.reel {
  padding: 0 var(--space-edge);
}

.frame {
  position: relative;
  background: var(--c-surface-soft);
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: var(--c-shadow);
}

.frame-perf::before,
.frame-perf::after {
  display: none;
}

.widescreen {
  position: relative;
  width: 100%;
  padding-top: 75%;
  background: var(--c-surface-soft);
  border-radius: var(--r-card);
  overflow: hidden;
}
.widescreen > image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.caption-overlay {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 32rpx 28rpx 24rpx;
  background: linear-gradient(to top, rgba(var(--c-text-rgb), 0.62), transparent);
  color: #fff;
  font-size: var(--fs-body);
  border-radius: 0 0 var(--r-card) var(--r-card);
}

.action-ring {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: none;
  background: var(--c-accent-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 14rpx 40rpx var(--c-accent-shadow);
}
.action-ring:active {
  transform: scale(0.96);
}

/* 右下角 +：贴纸 FAB（回忆） */
.fab-sticker {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx 38rpx 30rpx 36rpx;
  transform: rotate(2.5deg);
  background: var(--c-accent-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 14rpx 40rpx var(--c-accent-shadow);
}
.fab-sticker:active {
  transform: scale(0.96) rotate(0deg);
}

@keyframes ours-fade-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: ours-fade-in 480ms ease both;
}

.btn-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: var(--r-pill);
  background: var(--c-accent-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx var(--c-accent-shadow);
}
.btn-action--ghost {
  background: var(--c-surface);
  color: var(--c-text);
  border: 1rpx solid var(--c-divider);
  box-shadow: none;
}
.btn-action[disabled],
.btn-action.is-disabled {
  opacity: 0.45;
  box-shadow: none;
}

/* 通用按压反馈：元素加 hover-class="u-press" 即可获得轻微回弹 */
.u-press {
  opacity: 0.86;
  transform: scale(0.97);
}

/* 二级 Tab / 筛选：书签分段（回忆视图等） */
.seg-strip {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
}
.seg-sticker {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  color: var(--c-muted);
  border-radius: 22rpx 30rpx 18rpx 26rpx;
  transform: rotate(-1deg);
  transition: transform 0.15s ease;
}
.seg-sticker:active {
  transform: scale(0.97) rotate(0deg);
}
.seg-sticker.is-on {
  background: var(--c-accent-soft);
  color: var(--c-accent-deep);
  font-weight: 600;
  border-radius: 30rpx 20rpx 28rpx 24rpx;
  transform: rotate(1.2deg);
}
.seg-sticker--chip {
  flex: none;
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border-radius: 24rpx 18rpx 22rpx 28rpx;
  transform: rotate(-1.5deg);
  background: var(--c-surface);
}
.seg-sticker--chip.is-on {
  border-radius: 18rpx 28rpx 24rpx 20rpx;
  transform: rotate(1deg);
}

/* 弹层内发送：便签形（非全宽主 CTA） */
.sticker-send {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 26rpx 34rpx 22rpx 30rpx;
  transform: rotate(-1deg);
  background: var(--c-accent-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 22rpx var(--c-accent-shadow);
}
.sticker-send:active {
  transform: scale(0.96) rotate(0deg);
}
.sticker-send.is-off {
  opacity: 0.42;
  pointer-events: none;
  box-shadow: none;
}
.sticker-send--ghost {
  background: var(--c-surface);
  color: var(--c-text);
  border: 1rpx solid var(--c-divider);
  box-shadow: none;
  font-weight: 500;
}

.input-line {
  background: var(--c-surface);
  border-radius: var(--r-card);
  padding: 24rpx 28rpx;
  color: var(--c-text);
  border: 1rpx solid var(--c-divider);
}

.scene-rail {
  width: 128rpx;
  flex-shrink: 0;
  position: relative;
  padding-top: 16rpx;
  padding-right: 20rpx;
}
.scene-rail__no {
  font-size: 20rpx;
  color: var(--c-accent-deep);
}
.scene-rail__date {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--c-text);
  line-height: 1.15;
  margin-top: 4rpx;
}
.scene-rail__dow {
  font-size: 22rpx;
  color: var(--c-muted);
  margin-top: 4rpx;
}
.scene-rail--active::before {
  content: "";
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  right: 0;
  width: 4rpx;
  border-radius: 4rpx;
  background: var(--c-accent-gradient);
}

.empty-stage {
  padding: 120rpx 48rpx;
  text-align: center;
  color: var(--c-muted);
}
.empty-stage .key {
  color: var(--c-accent-deep);
  font-size: var(--fs-tag);
  display: block;
  margin-bottom: 20rpx;
}
.card-soft {
  background: var(--c-surface);
  border-radius: var(--r-card);
  box-shadow: var(--c-shadow);
  border: 1rpx solid var(--c-divider);
}
