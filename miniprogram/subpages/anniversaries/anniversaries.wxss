.page {
  min-height: 100vh;
  padding: 28rpx var(--space-edge) calc(48rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
}
.head { margin-bottom: 20rpx; display: flex; flex-direction: column; gap: 6rpx; }
.head__title { font-size: 40rpx; font-weight: 600; }
.head__sub { font-size: 24rpx; color: var(--c-muted); }
.row {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
}
.row__label { font-size: 28rpx; color: var(--c-muted); }
.row__val { font-size: 28rpx; color: var(--c-accent-deep); }
.list { display: flex; flex-direction: column; gap: 14rpx; }
.item { padding: 24rpx 28rpx; }
.item__title { font-size: 30rpx; font-weight: 600; color: var(--c-text); }
.item__date { display: block; font-size: 24rpx; color: var(--c-muted); margin-top: 6rpx; }
.item__countdown { display: block; margin-top: 12rpx; font-size: 28rpx; }
.item__del { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--c-accent-deep); }
.add-panel { margin-top: 20rpx; padding: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.add-panel__input {
  background: var(--c-surface-soft);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
}
.add-panel__picker { font-size: 28rpx; color: var(--c-text); }
.footer { margin-top: 28rpx; }
.accent { color: var(--c-accent-deep); font-weight: 600; }
