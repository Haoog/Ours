<view class="page grain" style="{{themeStyle}}">
  <view class="head">
    <text class="head__title serif">纪念日</text>
    <text class="head__sub">每年重复 · 首页显示最近一个倒计时</text>
  </view>

  <view class="list" wx:if="{{!empty}}">
    <view class="item card-soft" wx:for="{{list}}" wx:key="id">
      <view class="item__main">
        <text class="item__title">{{item.title}}</text>
        <text class="item__date">{{item.date}}</text>
      </view>
      <text class="item__countdown accent">{{item.label}}</text>
      <text class="item__del" data-id="{{item.id}}" bindtap="onDelete">删除</text>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="empty-stage">加载纪念日…</view>
  <view wx:elif="{{loadError}}" class="empty-stage" bindtap="refresh">{{loadError}} · 重试</view>
  <view wx:else class="empty-stage">
    <text class="key">还没有纪念日</text>
    <text>添加在一起、生日等特殊日子</text>
  </view>

  <view class="add-panel card-soft" wx:if="{{showAdd}}">
    <input class="add-panel__input" placeholder="名称，如：在一起" value="{{titleDraft}}" bindinput="onTitleInput" />
    <picker mode="date" value="{{dateDraft}}" bindchange="onPickDate">
      <view class="add-panel__picker">日期：{{dateDraft}}</view>
    </picker>
    <view class="btn-action {{submitting ? 'is-disabled' : ''}}" bindtap="onSubmitAdd">{{submitting ? '保存中…' : '保存'}}</view>
  </view>

  <view class="footer">
    <view class="btn-action btn-action--ghost" bindtap="onToggleAdd">{{showAdd ? '收起' : '添加纪念日'}}</view>
  </view>

</view>
