.page {
  min-height: 100vh;
  padding: 28rpx var(--space-edge) calc(48rpx + env(safe-area-inset-bottom));
  background: var(--c-bg);
}

.head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.head__title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--c-text);
}
.head__updated {
  font-size: 22rpx;
  color: var(--c-muted);
}

.block {
  padding: 26rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.block__h {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}
.block__p {
  font-size: 26rpx;
  color: var(--c-muted);
  line-height: 1.75;
}
